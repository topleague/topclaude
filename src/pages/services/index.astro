---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Services">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <h1 class="font-display text-4xl mb-10 text-center">Our Services</h1>
    <div class="grid md:grid-cols-3 gap-6">
      {services.map(s => (
        <a href={`/services/${s.id}/`} class="card p-7 block">
          <h3 class="font-bold text-lg mb-3">{s.data.title}</h3>
          <p class="text-sm text-[var(--ink-soft)] mb-5">{s.data.excerpt}</p>
          <span class="text-[var(--accent)] font-semibold text-sm">Learn more →</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
