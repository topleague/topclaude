---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/site.config';
---
<BaseLayout title="Contact">
  <div class="max-w-xl mx-auto px-6 py-16">
    <h1 class="font-display text-4xl mb-6 text-center">Get in Touch</h1>
    <p class="text-[var(--ink-soft)] text-center mb-8">Tell us about your project and we'll get back to you.</p>
    <form action="https://api.web3forms.com/submit" method="POST" class="space-y-4">
      <input type="hidden" name="access_key" value={SITE.web3formsKey} />
      <input type="hidden" name="subject" value="New contact form submission" />
      <input type="text" name="name" required placeholder="Your name"
             class="w-full px-4 py-3 rounded-lg border bg-[var(--paper)]" style="border-color: var(--line)" />
      <input type="email" name="email" required placeholder="Your email"
             class="w-full px-4 py-3 rounded-lg border bg-[var(--paper)]" style="border-color: var(--line)" />
      <textarea name="message" required rows="5" placeholder="Your message"
                class="w-full px-4 py-3 rounded-lg border bg-[var(--paper)]" style="border-color: var(--line)"></textarea>
      <button type="submit" class="btn w-full">Send Message</button>
    </form>
    <p class="text-xs text-[var(--ink-soft)] mt-4 text-center">
      Get a free access key at <a href="https://web3forms.com" class="underline">web3forms.com</a> and paste it into <code>src/site.config.ts</code>.
    </p>
  </div>
</BaseLayout>
