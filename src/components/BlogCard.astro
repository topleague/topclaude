---
import { formatDate } from '@/utils/formatDate';
const { post } = Astro.props;
---
<a href={`/blog/${post.id}/`} class="card block overflow-hidden group">
  <div class="aspect-[4/3] overflow-hidden bg-[var(--surface)]">
    {post.data.coverUrl && (
      <img src={post.data.coverUrl} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
    )}
  </div>
  <div class="p-5">
    <p class="text-xs uppercase tracking-wide text-[var(--ink-soft)] mb-2">{formatDate(post.data.date)}</p>
    <h3 class="font-bold leading-snug group-hover:text-[var(--accent)] transition-colors">{post.data.title}</h3>
  </div>
</a>
