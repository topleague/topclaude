---
import BlogCard from '@/components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---
<section class="max-w-6xl mx-auto px-6 py-16">
  <div class="text-center mb-12">
    <h2 class="font-display text-3xl mb-3">Your Content Optimization Toolkit</h2>
    <p class="text-[var(--ink-soft)]">Explore Expert Tips and Strategies to Elevate Your Content Game</p>
  </div>
  {posts.length > 0 ? (
    <div class="grid md:grid-cols-3 gap-6">
      {posts.map(post => <BlogCard post={post} />)}
    </div>
  ) : (
    <p class="text-center text-[var(--ink-soft)] text-sm">Add posts to src/content/posts/ to show them here.</p>
  )}
  <div class="text-center mt-8">
    <a href="/blog/" class="text-[var(--accent)] font-semibold">Browse All Articles →</a>
  </div>
</section>
