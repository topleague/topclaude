---
const testimonials = [
  { quote: "Top League have been excellent at presenting their work and work very hard to ensure that the quality of their work is always the best!", author: "Michael", role: "Founder, Idea Bubble" },
  { quote: "Top League over delivered on the articles we asked for. They were well written, concise and well optimized for search.", author: "Sean", role: "Founder, Acquisition Engine" },
  { quote: "The team did an excellent job on content creation for our appliance repair website.", author: "Alex Garayev", role: "Founder, SD Appliances" },
];
---
<section class="max-w-6xl mx-auto px-6 py-16">
  <div class="text-center mb-12">
    <h2 class="font-display text-3xl mb-3">Echoes of Excellence</h2>
    <p class="text-[var(--ink-soft)]">Our clients' stories reflect the trust and results that have fueled their continued partnership with us.</p>
  </div>
  <div class="grid md:grid-cols-3 gap-6">
    {testimonials.map(t => (
      <div class="card p-7">
        <p class="italic text-[var(--ink-soft)] mb-4 leading-relaxed">"{t.quote}"</p>
        <p class="font-bold text-sm">{t.author} <span class="font-normal text-[var(--ink-soft)]">/ {t.role}</span></p>
      </div>
    ))}
  </div>
</section>
