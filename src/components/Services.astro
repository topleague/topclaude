---
const services = [
  { title: "SEO Article Writing", body: "Turn your brand into an authority with our SEO-driven articles. Our expert writers craft compelling blog posts that don't just rank on Google—they build your reputation and engage your audience.", href: "/services/seo-article-writing/", img: "/assets/Article-Writing-Services--900x400.png" },
  { title: "Product Description Writing", body: "Boost your eCommerce game with product descriptions that convert. We specialize in crafting keyword-optimized, customer-centric descriptions that enhance your product's appeal and drive sales.", href: "/services/product-description-writing/", img: "/assets/how-to-write-a-product-description-that-sells-720x400.jpg" },
  { title: "Website Content Writing", body: "Give your website the voice it deserves. Our team writes content that's not only SEO-friendly but also compelling and professional, resonating with both search engines and your customers.", href: "/services/", img: "/assets/copywriting-720x400.jpg" },
];
---
<section class="max-w-6xl mx-auto px-6 py-16">
  <div class="text-center mb-12">
    <h2 class="font-display text-3xl mb-3">Content that Resonates with Audience's Pain Points</h2>
    <p class="text-[var(--ink-soft)]">No Fluff. Our Content Speaks Your Audience's Language and Adheres to SEO Standards</p>
  </div>
  <div class="grid md:grid-cols-3 gap-6">
    {services.map(s => (
      <div class="card overflow-hidden">
        <img src={s.img} alt={s.title} class="w-full aspect-[16/9] object-cover" loading="lazy" />
        <div class="p-6">
          <h3 class="font-bold text-lg mb-3">{s.title}</h3>
          <p class="text-sm text-[var(--ink-soft)] mb-5 leading-relaxed">{s.body}</p>
          <a href={s.href} class="btn-outline text-sm">Check Plans</a>
        </div>
      </div>
    ))}
  </div>
</section>
